<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
		<RootNamespace>PhotoAtomic.Clooney</RootNamespace>
		<AssemblyName>PhotoAtomic.Clooney</AssemblyName>
		<IsPackable>true</IsPackable>
		<Description>Roslyn source generators for deep clone ([Clonable]), structural diff ([Diffable]) and structural hash ([Hashable]) with cycle handling. The runtime types come from the PhotoAtomic.Clooney.Abstractions dependency.</Description>
		<PackageTags>source-generator;roslyn;clone;deep-clone;diff;hash</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- Pacchetto analyzer: niente lib/, le dll viaggiano in analyzers/dotnet/cs;
		     nessun symbol package (non ci sono pdb nel build output impacchettato). -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IncludeSymbols>false</IncludeSymbols>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- Il generatore e la sua dipendenza privata IndentedStrings nel load context analyzer
		     dei consumatori (equivalente NuGet del target _IncludeIndentedStringsInAnalyzerOutput). -->
		<None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="$(OutputPath)PhotoAtomic.IndentedStrings.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- The generator compiles against IndentedStrings (its Indent interpolated-string handler).
         PrivateAssets="all" keeps it out of the package dependency graph; the target below makes the
         DLL flow to every consumer's analyzer load context, so consumers don't reference it by hand. -->
		<ProjectReference Include="..\PhotoAtomic.IndentedStrings\PhotoAtomic.IndentedStrings.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\PhotoAtomic.Clooney.Abstractions\PhotoAtomic.Clooney.Abstractions.csproj" />
	</ItemGroup>

	<!-- A source generator runs inside Roslyn and can only load dependencies the consuming compilation
       lists as analyzers. GetTargetPathDependsOn lets this project add IndentedStrings.dll to the set a
       ProjectReference contributes, so any project referencing this generator as an analyzer gets the
       dependency transitively. IncludeRuntimeDependency="false" keeps it analyzer-only — it never lands
       in a consumer's runtime/publish output. (When packaged as NuGet instead, the equivalent is
       GeneratePathProperty + <None Pack="true" PackagePath="analyzers/dotnet/cs"> per the Roslyn cookbook.) -->
	<PropertyGroup>
		<GetTargetPathDependsOn>$(GetTargetPathDependsOn);_IncludeIndentedStringsInAnalyzerOutput</GetTargetPathDependsOn>
	</PropertyGroup>

	<Target Name="_IncludeIndentedStringsInAnalyzerOutput" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker Include="@(ReferencePath)"
												 Condition="'%(ReferencePath.FileName)' == 'PhotoAtomic.IndentedStrings'"
												 IncludeRuntimeDependency="false" />
		</ItemGroup>
	</Target>

</Project>
