<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Roslyn components must target netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Release tracking files are packaging ceremony we do not need yet. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <RootNamespace>PhotoAtomic.SourceGen</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Opt-in compile-time companion for PhotoAtomic.Internationalization: generates the translation catalog from your T($"...") call sites and ships the PAI18N001 analyzer that flags unresolvable contexts. Install next to the core package.</Description>
    <PackageTags>i18n;internationalization;source-generator;roslyn;analyzer</PackageTags>
    <!-- Pacchetto analyzer: niente lib/, le dll viaggiano in analyzers/dotnet/cs;
         nessun symbol package (non ci sono pdb nel build output impacchettato). -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Il generatore e la sua dipendenza privata IndentedStrings nel load context analyzer
         dei consumatori (equivalente NuGet del target _IncludeIndentedStringsInAnalyzerOutput). -->
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)PhotoAtomic.IndentedStrings.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tool reuses the extraction brain over MSBuildWorkspace compilations. -->
    <InternalsVisibleTo Include="PhotoAtomic.Internationalization.Tool" />
    <InternalsVisibleTo Include="PhotoAtomic.Internationalization.SourceGen.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- IndentedStrings vive in un posto solo anche a livello di build: ProjectReference con
         PrivateAssets="all" (fuori dal grafo di dipendenze NuGet) + il target sotto, che fa
         viaggiare la dll nel load context degli analyzer dei consumatori — stessa tecnica di
         PhotoAtomic.Clooney. -->
    <ProjectReference Include="..\PhotoAtomic.IndentedStrings\PhotoAtomic.IndentedStrings.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);_IncludeIndentedStringsInAnalyzerOutput</GetTargetPathDependsOn>
  </PropertyGroup>

  <Target Name="_IncludeIndentedStringsInAnalyzerOutput" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="@(ReferencePath)"
                                           Condition="'%(ReferencePath.FileName)' == 'PhotoAtomic.IndentedStrings'"
                                           IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>

</Project>
